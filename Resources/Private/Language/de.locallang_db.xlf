				<target>Beschriftung</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_label_text.description" resname="sys_file_metadata.tx_ntaimark_label_text.description">
				<source>Optional wording shown next to the icon, e.g. "Voices generated with AI". Leave empty for the default text.</source>
				<target>Optionaler Text neben dem Symbol, z. B. „Stimmen erzeugt mit KI“. Leer lassen für den Standardtext.</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_system" resname="sys_file_metadata.tx_ntaimark_system">
				<source>AI system</source>
