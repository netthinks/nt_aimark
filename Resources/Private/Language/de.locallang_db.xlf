				<source>Internal documentation only. Never shown in the frontend.</source>
				<target>Nur zur internen Nachweisführung. Wird nie im Frontend ausgegeben.</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_created_at" resname="sys_file_metadata.tx_ntaimark_created_at">
				<source>Created on</source>
				<target>Erzeugt am</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_created_at.description" resname="sys_file_metadata.tx_ntaimark_created_at.description">
				<source>When the content was created — not when it was uploaded or published. Content created before 2 August 2026 does not have to be labelled retroactively.</source>
				<target>Zeitpunkt der Erzeugung des Inhalts — nicht des Uploads oder der Veröffentlichung. Vor dem 2. August 2026 erzeugte Inhalte müssen nicht nachträglich gekennzeichnet werden.</target>
			</trans-unit>
