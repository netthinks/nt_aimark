			<trans-unit id="sys_file_metadata.tx_ntaimark_status" resname="sys_file_metadata.tx_ntaimark_status">
				<source>AI involvement</source>
				<target>KI-Anteil</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_status.description" resname="sys_file_metadata.tx_ntaimark_status.description">
				<source>To what extent was AI involved in creating this file? Only a confirmed status is used for labelling in the frontend.</source>
				<target>In welchem Umfang war KI an dieser Datei beteiligt? Nur ein bestätigter Status führt zu einer Kennzeichnung im Frontend.</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_disclosure" resname="sys_file_metadata.tx_ntaimark_disclosure">
				<source>Labelling</source>
				<target>Kennzeichnung</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_disclosure.description" resname="sys_file_metadata.tx_ntaimark_disclosure.description">
				<source>Leave on "automatic" unless you want to override the decision for this file.</source>
				<target>Auf „automatisch“ belassen, sofern die Entscheidung für diese Datei nicht bewusst übersteuert werden soll.</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_exempt_reason" resname="sys_file_metadata.tx_ntaimark_exempt_reason">
				<source>Reason for not labelling</source>
				<target>Grund für die Nichtkennzeichnung</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_exempt_reason.description" resname="sys_file_metadata.tx_ntaimark_exempt_reason.description">
				<source>Documents why this file is not labelled. Recorded in the audit trail.</source>
				<target>Dokumentiert, warum diese Datei nicht gekennzeichnet wird. Wird im Protokoll festgehalten.</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_icon" resname="sys_file_metadata.tx_ntaimark_icon">
				<source>Icon</source>
				<target>Symbol</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_icon.description" resname="sys_file_metadata.tx_ntaimark_icon.description">
				<source>Which of the official EU icons to show. "Automatic" derives it from the AI involvement.</source>
				<target>Welches der offiziellen EU-Symbole angezeigt wird. „Automatisch“ leitet es aus dem KI-Anteil ab.</target>
			</trans-unit>
			<trans-unit id="sys_file_metadata.tx_ntaimark_label_text" resname="sys_file_metadata.tx_ntaimark_label_text">
