				<target>PHP-Erweiterung exif</target>
			</trans-unit>
			<trans-unit id="status.exif.detail" resname="status.exif.detail">
				<source>Not installed, so the EXIF signature stage is skipped.</source>
				<target>Nicht installiert, deshalb entfällt die EXIF-Signaturstufe.</target>
